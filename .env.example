PORT=3790

# Supabase (obrigatório no Railway / Vercel)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Admin da área /admin
ADMIN_EMAIL=teste@gmail.com

# URL pública (Checkout / Portal / banner push)
# No Railway: use o domínio *.up.railway.app após gerar o domínio público
PUBLIC_BASE_URL=https://SEU-APP.up.railway.app

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_1U87aaLcve75re8rKD3UjDZa
STRIPE_PRICE_6M=price_1U87aaLcve75re8rXjAdHqri
STRIPE_PRICE_12M=price_1U87aZLcve75re8rgdyW6j06

# Cron automático — o Google (Apps Script / Cloud Scheduler) chama /api/cron/sync
CRON_SECRET=<gere um token longo; o Cloud Scheduler envia no header>

# Push Web (opcional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# Shopee/Meta NÃO vão como env global —
# cada usuário configura na própria conta após login (ou no cadastro).

# Claude / Anthropic — preferível na conta do usuário (Configurações → Conexões).
# CLAUDE_API_KEY= só como fallback local de desenvolvimento, se quiser.
# CLAUDE_MODEL=claude-sonnet-4-6

# Pinterest Ads API — opcional; preferível salvar na conta do usuário
PINTEREST_APP_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_IDS=

# Checklist Railway: veja railway.env.example + DEPLOY.md
# Emissão fiscal NFS-e. Mantenha desligado até homologação do leiaute, revisão
# do contador e teste com certificado A1 do próprio emitente.
FISCAL_PRODUCTION_ENABLED=0
FISCAL_LAYOUT_VERSION=1.01
# Produção restrita (homologação da Sefin Nacional) para testes com certificado real.
FISCAL_RESTRICTED_ENABLED=0
# ACs ICP-Brasil (PEM ou caminho). Vazio = usa certs/icp-brasil.pem (pacote oficial do ITI).
FISCAL_ICP_ROOTS_PEM=
# Opcional: zip local do pacote XSD oficial (senão é baixado do gov.br).
FISCAL_XSD_PATH=
# Opcional: caminho dos parâmetros municipais, se o padrão não responder.
# FISCAL_PARAMS_SERVICE=adn
# FISCAL_PARAMS_PREFIX=/parametrizacao/parametros_municipais
